# Server Configuration
PORT=5000

# Redis Cache URL
# Local Redis: redis://127.0.0.1:6379
# Cloud Redis (Upstash / Redis Cloud): rediss://default:your_password@your_endpoint.upstash.io:6379
REDIS_URL=redis://127.0.0.1:6379

# Google reCAPTCHA v3 Secret Key (Get from https://www.google.com/recaptcha/admin)
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key_here

# MongoDB Atlas Multi-Cluster / Multi-DB Failover & Load Balancing
# Pass comma-separated connection URIs or MONGODB_URI_1, MONGODB_URI_2, etc.
MONGODB_URIS=mongodb+srv://username:password@cluster1.mongodb.net/famn,mongodb+srv://username:password@cluster2.mongodb.net/famn
# MONGODB_URI_1=mongodb+srv://username:password@cluster1.mongodb.net/famn
# MONGODB_URI_2=mongodb+srv://username:password@cluster2.mongodb.net/famn
# Health Dashboard Security Password
HEALTH_DASHBOARD_PASSWORD=famn_admin_2026
